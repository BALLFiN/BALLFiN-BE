    "from app.services.chat_service import ask_llm_clova"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "e8654cc2",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "ask to clova\n",
      "🔍 웹 검색 도구 사용: 오늘뉴스\n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "\"**📊 오늘의 금융 브리핑 — 2025-07-29**\\n\\n1. **경기 살리기 통큰세일 개막**\\n   - 경기지역 400여 개 전통시장과 골목상권이 참여하는 소비 촉진 행사인 '2025 경기 살리기 통큰세일'이 오산시 오색시장에서 개막했습니다. 9일간 진행됩니다.\\n   \\n2. **이란의 반(反)이스라엘 정서 확산**\\n   - 이스라엘-이란 교전으로 인해 이란에서는 반(反)이스라엘 정서와 반정부 정서가 동시에 증가하고 있는 것으로 전해졌습니다. BBC 보도에 따르면, 인명 피해도 속출하고 있습니다.\\n   \\n3. **전북 지역에 많은 비**\\n   - 전날부터 이날 오후 5시까지 전북 익산에 165mm, 군산에 158mm 등의 강수량이 기록되었습니다. 도내 평균 강수량은 131mm였습니다.\\n   \\n4. **더불어민주당 박찬대 의원 당대표 출마 선언**\\n   - 더불어민주당 박찬대 의원이 오는 23일 당 대표 선거 출마를 공식적으로 선언했습니다.\\n\\n**추가 정보가 필요하시면 언제든 말씀해 주세요!**\""
      ]
     },
     "execution_count": 2,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
